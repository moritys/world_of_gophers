# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4
max_line_length = off

[go.mod]
indent_style = tab

[{Makefile,Dockerfile}]
indent_style = tab

# YAML требует пробелы — табы там синтаксическая ошибка
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,md}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

# Golden-файлы тестов не трогать — содержимое значимо байт в байт
[*.golden]
trim_trailing_whitespace = false
insert_final_newline = false

# Два пробела в конце строки в Markdown = перенос строки
[*.md]
trim_trailing_whitespace = false
